# Copy to .env and fill in. .env is gitignored; .env.example is not, so never
# put a real token in this file.

# ---------------------------------------------------------------------------
# Who may connect (required for any non-loopback bind)
# ---------------------------------------------------------------------------
# One name:token pair per person, comma separated. Per-person rather than one
# shared secret, so logs and rate limits name a human and revoking one person
# does not re-key the team.
#
# Generate each one with:   openssl rand -hex 24
OPENSCRAPE_MCP_TOKENS=alice:REPLACE_ME_32_HEX_CHARS,bob:REPLACE_ME_32_HEX_CHARS

# ---------------------------------------------------------------------------
# Where it listens
# ---------------------------------------------------------------------------
OPENSCRAPE_MCP_HOST=0.0.0.0
OPENSCRAPE_MCP_PORT=3100

# The public hostname(s) clients will use. Setting this turns on DNS-rebinding
# protection, which stops a web page in someone's browser driving this server.
# OPENSCRAPE_MCP_ALLOWED_HOSTS=scrape.yourcompany.com

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Concurrent tool calls per person. A browser page costs ~100x an HTTP GET, so
# this is the dial that stops one person slowing everyone down.
OPENSCRAPE_MCP_PER_USER=6

# Drop a session after this long with no request (ms). Abandoned sessions are
# reaped because each one holds a server object and possibly a browser context.
OPENSCRAPE_MCP_IDLE_MS=1800000

# Hard cap on simultaneous sessions.
OPENSCRAPE_MCP_MAX_SESSIONS=200

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# "hosted" turns off local file reads, page scripts and private-network
# targets, and enforces robots.txt. Leave this on for any shared instance.
OPENSCRAPE_MODE=hosted

# Only set this if the instance is meant to scrape your own internal hosts.
# On a shared box it lets any token holder reach your private network and the
# cloud metadata endpoint, so it is off by default.
# OPENSCRAPE_ALLOW_PRIVATE_TARGETS=1

# ---------------------------------------------------------------------------
# Search (required for `search` to work at all on a hosted instance)
# ---------------------------------------------------------------------------
# docker-compose.yml runs SearxNG as a sidecar and points OPENSCRAPE_SEARXNG_URL
# at it, so there is nothing to set here for that — except this secret, which
# has no safe default. Compose refuses to start without it.
#
# Generate with:   openssl rand -hex 32
SEARXNG_SECRET=REPLACE_ME_64_HEX_CHARS

# Pin the SearxNG image once you know a tag that works for you. Defaults to
# `latest`, which is what SearxNG's own compose file uses.
# SEARXNG_VERSION=latest

# Optional second provider. Brave has no free tier as of 9 Nov 2026 — $5 per
# 1000 requests with a $5 monthly credit, card required — so SearxNG above is
# the one that actually removes the limits. Note the name: the code reads
# BRAVE_SEARCH_API_KEY, and an earlier version of this file named a variable
# that nothing read, which left Brave silently off.
# BRAVE_SEARCH_API_KEY=

# Only needed if you are NOT using the compose sidecar, e.g. a SearxNG you
# already run elsewhere.
# OPENSCRAPE_SEARXNG_URL=http://searxng:8080

# ---------------------------------------------------------------------------
# Optional: your own proxies, for sites that block datacentre IPs
# ---------------------------------------------------------------------------
# OPENSCRAPE_PROXIES=http://user:pass@host:port,http://user:pass@host2:port

# Verbose logging on stderr.
# OPENSCRAPE_DEBUG=1
