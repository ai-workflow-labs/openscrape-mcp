{
  "name": "openscrape-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Free, local, self-hosted Firecrawl alternative exposed as an MCP server",
  "type": "module",
  "bin": {
    "openscrape-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "try": "tsx scripts/try.ts",
    "serve": "tsx src/http/server.ts",
    "serve:dist": "node dist/http/server.js",
    "test": "tsx scripts/integration-test.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mozilla/readability": "^0.5.0",
    "@xmldom/xmldom": "^0.9.12",
    "cheerio": "^1.0.0",
    "diff": "^9.0.0",
    "fast-xml-parser": "^4.5.0",
    "linkedom": "^0.18.0",
    "mammoth": "^1.8.0",
    "playwright": "^1.64.1",
    "robots-parser": "^3.0.1",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^7.0.0",
    "unpdf": "^0.12.0",
    "xpath": "^0.0.36",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
